# Apache 2.4 config for the chess app (requires AllowOverride FileInfo Indexes).
AddType application/wasm .wasm
AddType image/svg+xml .svg
AddType text/javascript .js

DirectoryIndex index.html
Options -Indexes

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/wasm image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(wasm|svg|css|js)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    <Files "index.html">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>

# Don't serve deployment files if the whole repo is copied into the docroot.
<FilesMatch "^(Dockerfile|compose\.yaml|nginx\.conf|\.dockerignore|\.gitignore|README\.md)$">
    Require all denied
</FilesMatch>
