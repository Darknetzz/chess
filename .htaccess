# Apache 2.4 config for the chess app (requires AllowOverride FileInfo Indexes AuthConfig Limit).
# PHP 8.5 with pdo_sqlite must handle api/*.php; the SQLite DB lives in data/ (or $DATA_DIR).
AddType application/wasm .wasm
AddType image/svg+xml .svg
AddType text/javascript .js

DirectoryIndex index.html
Options -Indexes

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/wasm image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    # Cross-origin isolation: lets the multi-threaded Stockfish use SharedArrayBuffer.
    # Every cross-origin resource must then opt in (CORS + crossorigin attribute, or CORP).
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Embedder-Policy "require-corp"
    <FilesMatch "\.(wasm|svg|css|js)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    <Files "index.html">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>

# Don't serve deployment files if the whole repo is copied into the docroot.
<FilesMatch "^(Dockerfile|compose\.yaml|nginx\.conf|\.dockerignore|\.gitignore|README\.md)$|\.(sqlite|sqlite-wal|sqlite-shm)$">
    Require all denied
</FilesMatch>

RedirectMatch 404 ^/(.*/)?data/
