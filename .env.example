# Copy to .env and uncomment what you change. Every value shown is the default.
# docker compose reads the CHESS_* variables below (see compose.yaml).

# Image tag for both containers: latest (newest release), edge (newest dev commit), X.Y.Z or build-N.
#CHESS_IMAGE_TAG=latest

# ---- Web app (chess container) -------------------------------------------
# Host port the site is published on.
#CHESS_PORT=8080
# Allow new account sign-ups. false / 0 / no / off disables registration (existing users can still log in).
#CHESS_REGISTRATION_OPEN=true

# ---- Bot API (bot container) ---------------------------------------------
# Default per-move time limit (ms) for games created without a clock or move_time_ms. Clamped to 1000-86400000.
#CHESS_BOT_MOVE_TIME_MS=30000
# Games one client IP may create per hour; more get HTTP 429.
#CHESS_BOT_CREATE_PER_HOUR=30
# Reverse proxies in front of the bot that append to X-Forwarded-For (bundled Apache = 1).
# Set 2 behind another proxy (e.g. NPMplus), otherwise all clients share one rate limit. 0 = use the socket address.
#CHESS_BOT_PROXY_HOPS=1

# Server-side Stockfish (headless games with an engine side, and its draw-offer evaluation):
# parallel engine processes (each single-threaded, 16 MB hash), max search depth, max ms per search.
#CHESS_BOT_ENGINE_MAX_PROCS=2
#CHESS_BOT_ENGINE_MAX_DEPTH=30
#CHESS_BOT_ENGINE_MAX_MS=2000

# MCP over HTTP at /mcp: bearer token clients must send. Empty disables /mcp (404).
# Generate one with: openssl rand -base64 32
#CHESS_MCP_TOKEN=
# Comma-separated browser origins allowed to call /mcp (requests with any other Origin header get 403).
# MCP clients normally send no Origin, so leave empty unless a browser-based client needs access.
#CHESS_MCP_ALLOWED_ORIGINS=
# Default web-app API key for the MCP library tools (list_library_games, create_game library_game_id).
# Create it in the web app (key button next to your name). Empty: agents must pass library_key themselves.
#CHESS_MCP_LIBRARY_KEY=
# Where the bot service reaches the web app for those tools (the "chess" service in this compose file).
#CHESS_LIBRARY_API_URL=http://chess

# ---- Without Docker --------------------------------------------------------
# Not read by compose: set these in the environment of the processes themselves.
#
# PHP (api/*.php):
#   DATA_DIR=<repo>/data          writable directory for chess.sqlite; keep it outside the docroot (Docker: /data)
#   REGISTRATION_OPEN=true        same as CHESS_REGISTRATION_OPEN
#
# Bot API (node bot/server.mjs):
#   PORT=3000                     listen port
#   DATA_DIR=<repo>/data          writable directory for bot.sqlite (Docker: /data)
#   BOT_WAIT_MS=30000             long-poll timeout of GET /api/games/{id}/wait (MCP waits at most 25000)
#   BOT_MOVE_TIME_MS, BOT_CREATE_PER_HOUR, BOT_PROXY_HOPS, BOT_ENGINE_MAX_PROCS, BOT_ENGINE_MAX_DEPTH,
#   BOT_ENGINE_MAX_MS, MCP_TOKEN, MCP_ALLOWED_ORIGINS, MCP_LIBRARY_KEY, LIBRARY_API_URL
#                                 same as the CHESS_* variables above, without the prefix
#
# MCP over stdio (node bot/mcp.mjs):
#   BOT_API_URL=http://localhost:3000   site root of the bot API to talk to (also where the saved-games library is read)
#   LIBRARY_KEY=ck_…                    optional default web-app API key for the library tools
